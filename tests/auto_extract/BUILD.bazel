load("@jq.bzl", "jq")
load("@jq.bzl//jq:jq.bzl", "jq_test")
load("//formatjs:defs.bzl", "formatjs_extract")
load(":fixtures.bzl", "adapter_catalogs", "alias_catalogs", "batch_catalogs", "batch_report", "catalogs", "collection_only_catalogs", "custom_action", "custom_catalogs", "graph", "ignored", "metadata", "python_source", "report", "runtime", "scoped_catalogs", "selected_alias_catalogs", "source_chain", "unmatched_report")

exports_files(
    ["foreign.py"],
    visibility = ["//visibility:public"],
)

runtime(name = "runtime")

runtime(
    name = "runtime_with_sources",
    srcs = ["foreign.py"],
    visibility = ["//visibility:public"],
)

alias(
    name = "runtime_alias",
    actual = ":runtime",
)

graph(
    name = "leaf",
    srcs = select({"//conditions:default": ["leaf.py"]}),
    deps = select({"//conditions:default": [":runtime_alias"]}),
)

alias(
    name = "leaf_alias",
    actual = ":leaf",
)

graph(
    name = "bridge",
    deps = [":leaf_alias"],
)

formatjs_extract(
    name = "legacy",
    srcs = ["legacy.tsx"],
    extract_source_location = True,
)

metadata(
    name = "legacy_sources",
    srcs = ["legacy.tsx"],
    extraction = ":legacy",
)

graph(
    name = "root",
    srcs = [
        "root.rs",
        ":legacy_sources",
    ],
    deps = [
        ":bridge",
        ":leaf",
    ],
)

catalogs(
    name = "root_catalogs",
    target = ":root",
)

jq(
    name = "merged",
    srcs = [":root_catalogs"],
    args = ["--slurp"],
    filter = "add | [.[] | (.defaultMessage // .message)] | sort",
)

jq_test(
    name = "messages_test",
    file1 = ":merged",
    file2 = "messages.json",
)

